# vigolium-settings.env — the settings this setup runs on.
#
# Read by scripts/apply-settings.sh, applied with `vigolium config set`.
# Format: KEY="value"   (quotes keep [lists] and spaces intact)
#
# Every knob that differs from a vanilla install is here, with its vanilla
# default and what it actually does. Anything not listed is left at default.
#
# Secrets are deliberately NOT here (agent.olium.custom_provider.api_key,
# oast.token, …). `config set` writes them into
# ~/.vigolium/vigolium-configs.yaml in cleartext; set them by hand, once per
# machine — see README.md.

# ─── agent loop budget ───────────────────────────────────────────────────────
# Vanilla 32. One turn = one model response plus its tool calls. This is the
# per-run hard cap, and it is what the `olium: exceeded max turns (32)` abort
# comes from — the triage and query paths inherit it too.
agent.olium.max_turns="400"

# Vanilla 0 (provider default). Per-response *output* cap, honored by the
# Anthropic transports only: an OpenAI-compatible endpoint (fireworks, ollama)
# ignores it, so with the provider below this is effectively inert.
agent.olium.max_tokens="1000000"

# Vanilla 600. Deadline for a single model call. Ten minutes is not enough for a
# long turn with a large context, and a call that hits it dies mid-run.
agent.olium.call_timeout_sec="3600"

# Vanilla 3 / 12. The loop closes a section after N consecutive turns with no
# *productive* tool call and stops the run after M stall rotations in a row.
# The progress detector only counts target-touching tools (run_native_scan,
# web_fetch, send_raw_http, browser_probe, report_finding) — verifying through
# bash: reading source, querying the target's database, replaying a request by
# hand, reads as a stall. Raised because that is exactly this workflow.
agent.olium.stall_rotations="5"
agent.olium.stall_turns="20"

# Vanilla "" (= legacy: no section rotation, report_finding writes findings
# directly). shadow = bounded operator sections with context rotation, and every
# report_finding is *also* mirrored into agent_finding_candidates so a
# fresh-context verifier can grade them — findings still land immediately, the
# mirror is what the FP-rate comparison reads. enforced = findings only via
# propose_candidate → verify → promote. Unrecognized values fall back to legacy.
agent.olium.autopilot_mode="shadow"

# ─── model provider ─────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint; the vanilla default is a local ollama
# (http://localhost:11434/v1, gemma4:latest). api_key is NOT here — see header.
agent.olium.custom_provider.base_url="https://api.fireworks.ai/inference/v1"
agent.olium.custom_provider.model_id="accounts/fireworks/models/deepseek-v4p1-flash"

# ─── what the agent keeps in context ────────────────────────────────────────
# Vanilla defaults, straight from the code: 50 findings, 100 endpoints, 20
# high-risk items, risk score >= 50. Raised (and the risk bar lowered) so a deep
# audit keeps most of the scan in view instead of silently dropping medium-risk
# items. These four keys are not emitted by the default config at all — they
# only exist once something sets them.
agent.context_limits.max_findings="200"
agent.context_limits.max_endpoints="400"
agent.context_limits.max_high_risk="60"
agent.context_limits.min_risk_score="30"

# ─── discovery (deparos) ────────────────────────────────────────────────────
# Vanilla "auto". Which built-in wordlist tier discovery uses; valid values are
# auto | short | long | large (note: only scope.cli_origin_mode is validated on
# write, so a typo here is accepted silently). "large" is the widest.
discovery.wordlists.tier="large"

# Vanilla [] (dedup per path). Responses with these statuses collapse to ONE
# representative per host instead of one per path: 401/403 auth-wall noise,
# 429 rate limiting, 405/415/422 method/format noise.
discovery.deparos_dedup.keep_one_per_host="[401, 403, 429]"
discovery.deparos_dedup.keep_per_path="[405, 415, 422]"

# Vanilla 4000. Cap on observed items held per discovery run.
discovery.engine.observed_max_items="20000"

# Vanilla 0 (derived from CPUs and RAM). Pinned so the embedded JS engine
# (jstangle) has a predictable budget on a box that is also doing the scanning.
discovery.jstangle.memory_budget_mb="768"

# ─── spidering (spitolas) and pacing ────────────────────────────────────────
# Vanilla 1500. Distinct crawler states one run may keep.
spidering.max_states="5000"
# Vanilla 50. Cap on extra route seeds one target's crawl browses. The config
# does not document what 0 means; this install pins 0.
spidering.max_extra_seeds="0"
# Vanilla 25. Parallel requests per host.
scanning_pace.concurrency="40"
# Vanilla empty (no wall-clock limit). Stops spidering after this long.
scanning_pace.spidering.max_duration="30m"

# ─── scope and phases ───────────────────────────────────────────────────────
# Vanilla "balanced"; validated on write, must be all | relaxed | balanced |
# strict. How scope filtering treats targets that came from the CLI (-t):
# relaxed keeps more of what those targets lead to.
scope.cli_origin_mode="relaxed"

# Vanilla false. Enrich known-issue (template) scan targets with paths found in
# earlier phases: more coverage, slower scan.
known_issue_scan.enrich_targets="true"
# Vanilla false. Same enrichment for the "lite" scanning strategy.
scanning_strategy.lite.known_issue_scan="true"

# Vanilla 1. API version the REST server serves when a client does not pin one.
server.api_version_default="0"

# Vanilla 1. Feedback rounds in the dynamic assessment phase: URLs discovered in
# a round are fed back and re-scanned, up to N rounds.
dynamic-assessment.max_feedback_rounds="3"

# ─── repair: keys this config carried as null/"" ────────────────────────────
# An older `config set` round-trip left these null or empty in
# ~/.vigolium/vigolium-configs.yaml, so their effective value quietly came from
# the code defaults. Pinning them to those documented defaults makes the
# configuration explicit. Safe to delete this block if you prefer them unset.
discovery.flush_interval="15s"
discovery.stream_fuzz="true"
discovery.sitemap.enabled="true"
discovery.sitemap.follow_index="true"
discovery.jstangle.persist_unreplayed="true"
spidering.route_seeds="true"
scanning_strategy.scan_logs.status_retention_days="30"
